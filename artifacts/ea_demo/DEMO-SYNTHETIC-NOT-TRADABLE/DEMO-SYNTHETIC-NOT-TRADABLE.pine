//@version=5
// DEMO-SYNTHETIC-NOT-TRADABLE -- AGLE Strategy Factory (GEN 14 QUALIFIED)
// spec_hash : 1a14fb2368f053159269e0bfcfeb9732f42728c1eff20d57d434f4ddfde2dc7b
// mechanism : DEMONSTRATION ONLY -- fade the 3rd consecutive same-direction H1 bar
strategy("DEMO-SYNTHETIC-NOT-TRADABLE", overlay=true, initial_capital=10000,
         default_qty_type=strategy.percent_of_equity, default_qty_value=2,
         commission_type=strategy.commission.percent, commission_value=0.01)

holdBars = input.int(4, "Holding horizon (bars)")
hourFrom = input.int(7, "Hour from")
hourTo   = input.int(17, "Hour to")

hourOk = hour >= hourFrom and hour < hourTo
volOk  = ta.atr(14) > ta.atr(50)
range_ = high - low
nr7    = range_ < ta.lowest(range_, 7)[1]

streak = ta.barssince(close <= open) 
upRun  = ta.rising(close, 3)
dnRun  = ta.falling(close, 3)
long_  = dnRun and hourOk and volOk
short_ = upRun and hourOk and volOk

if long_
    strategy.entry("L", strategy.long)
if short_
    strategy.entry("S", strategy.short)

barsHeld = ta.barssince(strategy.opentrades > 0 and strategy.opentrades[1] == 0)
if strategy.opentrades > 0 and barsHeld >= holdBars
    strategy.close_all(comment="horizon exit")
