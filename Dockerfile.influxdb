# ---------------------------------------------------------------------------
# EA Factory Pro - InfluxDB time-series store (ticks, OHLCV, metrics)
# ---------------------------------------------------------------------------
FROM influxdb:2.7-alpine

ENV DOCKER_INFLUXDB_INIT_MODE=setup \
    DOCKER_INFLUXDB_INIT_USERNAME=eafactory \
    DOCKER_INFLUXDB_INIT_PASSWORD=eafactory123 \
    DOCKER_INFLUXDB_INIT_ORG=ea-factory \
    DOCKER_INFLUXDB_INIT_BUCKET=market \
    DOCKER_INFLUXDB_INIT_RETENTION=90d \
    DOCKER_INFLUXDB_INIT_ADMIN_TOKEN=ea-factory-dev-token

# Runs once after the initial setup completes.
COPY docker/influxdb/init.sh /docker-entrypoint-initdb.d/init.sh

EXPOSE 8086
