# ---------------------------------------------------------------------------
# EA Factory Pro - environment template. Copy to `.env` and fill in.
#   cp .env.example .env
# NEVER commit the real .env file.
# ---------------------------------------------------------------------------

# --- Runtime -----------------------------------------------------------------
ENVIRONMENT=development
LOG_LEVEL=INFO
LOG_JSON=false

# --- Broker (XMTrading) -------------------------------------------------------
# XM_MODE controls how the broker layer behaves:
#   simulated -> fully local paper-trading engine (no credentials needed, default)
#   rest      -> talk to a real XM-compatible REST/WebSocket gateway
XM_MODE=simulated
XM_DEMO=true
XM_ACCOUNT_ID=
XM_PASSWORD=
XM_SERVER=XMGlobal-Demo
XM_REST_URL=https://demo.xm.com/api
XM_WS_URL=wss://demo.xm.com/ws

# --- Datastores ---------------------------------------------------------------
# Leave POSTGRES_* empty to fall back to a local SQLite file (dev friendly).
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=eafactory
POSTGRES_USER=eafactory
POSTGRES_PASSWORD=eafactory
DATABASE_URL=

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0

INFLUXDB_URL=http://influxdb:8086
INFLUXDB_TOKEN=ea-factory-dev-token
INFLUXDB_ORG=ea-factory
INFLUXDB_BUCKET=market

# --- API ---------------------------------------------------------------------
API_URL=http://api:8000
API_JWT_SECRET=change-me-in-production
API_JWT_EXPIRE_MINUTES=720
API_USERNAME=admin
API_PASSWORD=admin
API_AUTH_ENABLED=false

# --- LLM providers (optional, used by the Research/Meta agents) ---------------
LLM_PROVIDER=heuristic
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OLLAMA_URL=http://localhost:11434

# --- Market data providers (optional) ----------------------------------------
ALPHAVANTAGE_API_KEY=

# --- Notifications (optional) -------------------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
NOTIFY_EMAIL_TO=
