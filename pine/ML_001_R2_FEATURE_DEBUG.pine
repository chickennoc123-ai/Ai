//@version=6
// ============================================================
// ML-001-R2 FEATURE DEBUG SCRIPT (FE-R2-002)
// ============================================================
// Purpose: let a human open EURUSD or GBPUSD H1 in TradingView, add
// this script, and manually inspect momentum_5, momentum_20, rsi_14,
// atr_14, volatility_regime, bar timestamp, bar index, and per-feature
// warmup status -- per Phase 4 of the Python<->Pine parity project.
//
// This script also contains an OPTIONAL "Fixture Replay Mode" that
// recomputes the canonical formulas against an embedded 160-bar subset
// of ML-001-R2-PINE-PARITY-FIXTURE.csv (bars 0-159, generated by the
// REAL Python core/features/fe_r2_001.py pipeline) and compares the
// result, bar-by-bar, against Python's own recorded expected values.
// This is the only way to get a genuine Pine-vs-Python NUMERICAL
// comparison without a Pine compiler in the authoring environment --
// see ML-001-R2-PYTHON-PINE-PARITY-REPORT.md for how this evidence is
// used and what it does NOT prove (it does not prove the CANONICAL
// block below -- which runs on live chart data -- behaves identically;
// it proves the recurrence algorithm itself, reused via f_seededWilder,
// reproduces Python's numbers when fed identical input bars).
//
// GOVERNANCE: MANUAL PARITY TESTING ONLY. Not a production or trading
// tool. ECONOMIC_VALIDITY remains UNPROVEN. PRODUCTION remains BLOCKED.
// ============================================================
indicator("ML-001-R2 Feature Debug (FE-R2-002)", shorttitle = "ML001R2-DEBUG", overlay = false)

debugMode         = input.bool(true,  title = "Debug Mode (show summary table)")
fixtureReplayMode = input.bool(false, title = "Fixture Replay Mode (compare Pine vs Python, bars 0-159 only)")

// ============================================================
// ML-001-R2 CANONICAL FEATURE BLOCK -- BEGIN
// This exact block (between BEGIN/END markers) is duplicated VERBATIM
// across ml_001_r2_features.pine, ML_001_R2_FEATURE_DEBUG.pine, and
// ML_001_R2_STRATEGY.pine. Pine has no local multi-file import without
// first publishing a library to TradingView (not done here, since this
// is a private manual-test artifact) -- so "single canonical
// implementation" is enforced by verbatim textual identity across the
// three files, checked by an automated diff (tests/test_pine_parity.py),
// not by Pine's own import mechanism. See
// ML-001-R2-PYTHON-PINE-PARITY-REPORT.md, Structural Parity section.
// DO NOT hand-edit this block independently in any one file -- edit it
// once, then copy verbatim to the other two.
// ============================================================

// --- [0]/[1] momentum_5, momentum_20 ---
// Python: momentum[t] = (close[t]-close[t-lookback])/close[t-lookback]
momentum_5_raw  = (close - close[5])  / close[5]
momentum_20_raw = (close - close[20]) / close[20]

// --- RSI inputs: delta / gain / loss ---
// Python: delta[t]=close[t]-close[t-1] (na at bar 0, no prior close);
//         gain=max(delta,0); loss=max(-delta,0), both na wherever delta is na.
delta_ = close - close[1]
gain_  = na(delta_) ? na : (delta_ >= 0 ? delta_ : 0.0)
loss_  = na(delta_) ? na : (delta_ <  0 ? -delta_ : 0.0)

// --- seeded Wilder smoothing (explicit -- NOT ta.rma()) ---
// Mirrors core/features/fe_r2_001.py::_seeded_wilder_smooth exactly:
//   seed  = simple mean of the first `period` valid values, counted
//           from `firstValidOffset` (the bar_index where the raw input
//           series itself first becomes defined)
//   avg[t] = (avg[t-1]*(period-1) + value[t]) / period thereafter
// Implemented with `var` persistent per-call-site state, not any
// built-in smoothing function, so behavior is directly auditable
// against the Python source rather than relying on an unverified
// assumption about a library function's internal seed semantics.
f_seededWilder(float value, int period, int firstValidOffset) =>
    var float avgOut    = na
    var float seedSum   = 0.0
    var int   seedCount = 0
    if bar_index >= firstValidOffset and not na(value)
        if seedCount < period
            seedSum   := seedSum + value
            seedCount := seedCount + 1
            if seedCount == period
                avgOut := seedSum / period
        else
            avgOut := (avgOut * (period - 1) + value) / period
    avgOut

avg_gain = f_seededWilder(gain_, 14, 1)
avg_loss = f_seededWilder(loss_, 14, 1)

// --- [2] rsi_14 ---
// Python division-by-zero convention (spec Section 4, Step 5):
//   avg_loss=0 & avg_gain>0 -> RSI=100 (RS -> inf, correct, not an error)
//   avg_loss=0 & avg_gain=0 -> RSI=50 (flat market, defined neutral, not 0/0)
rsi_14_raw = na(avg_gain) or na(avg_loss) ? na :
             (avg_loss == 0.0 and avg_gain == 0.0) ? 50.0 :
             (avg_loss == 0.0) ? 100.0 :
             100.0 - 100.0 / (1.0 + avg_gain / avg_loss)

// --- True Range (no seeding ambiguity -- stateless per-bar max) ---
// Python: TR[t] = max(high-low, |high-prevclose|, |low-prevclose|);
//         TR[0] = high[0]-low[0] (the only defined term, no prior close).
// IMPORTANT: Python's true_range relies on pandas DataFrame.max(axis=1,
// skipna=True) to produce this bar-0 fallback automatically. Pine's
// math.max() does NOT reliably reproduce that skipna fallback (na
// propagates through math.max in Pine), so the bar-0 case is handled
// with an EXPLICIT branch here rather than assumed equivalent --
// a discrepancy class this project's own M-5 remediation specifically
// warned against assuming away.
prevClose_ = close[1]
tr_ = bar_index == 0 ? (high - low) :
      math.max(high - low, math.max(math.abs(high - prevClose_), math.abs(low - prevClose_)))

// --- [3] atr_14 ---
// atr_14_raw_unmasked: the UNMASKED recurrence output, used internally
// for volatility_regime's percentile calculation (Python computes
// volatility_regime from the raw, not warmup-masked, atr_14 -- see
// core/features/fe_r2_001.py::build_feature_matrix: compute_volatility_regime
// is called on atr_14 BEFORE _apply_warmup runs). Do not substitute the
// warmup-masked atr_14 here; that would diverge from the Python pipeline.
atr_14_raw_unmasked = f_seededWilder(tr_, 14, 0)

// --- [4] volatility_regime ---
// Python: 500-bar trailing causal percentile of atr_14 (33rd/67th,
// linear interpolation), computed on the RAW atr_14 series.
// ASSUMPTION (not verified by execution -- flag in parity report):
// ta.percentile_linear_interpolation(source, length, percentage)
// requires `length` consecutive defined bars before returning a
// non-na value, mirroring pandas' rolling(..., min_periods=window).
p33_ = ta.percentile_linear_interpolation(atr_14_raw_unmasked, 500, 33)
p67_ = ta.percentile_linear_interpolation(atr_14_raw_unmasked, 500, 67)

volatility_regime_raw = na(atr_14_raw_unmasked) or na(p33_) or na(p67_) ? na :
     atr_14_raw_unmasked < p33_ ? 0.0 :
     atr_14_raw_unmasked > p67_ ? 2.0 : 1.0

// --- WARMUP_BARS masking (applied to OUTPUT columns only; spec Section 4) ---
// {momentum_5:5, momentum_20:20, rsi_14:100, atr_14:100, volatility_regime:600}
momentum_5        = bar_index < 5   ? na : momentum_5_raw
momentum_20       = bar_index < 20  ? na : momentum_20_raw
rsi_14            = bar_index < 100 ? na : rsi_14_raw
atr_14            = bar_index < 100 ? na : atr_14_raw_unmasked
volatility_regime = bar_index < 600 ? na : volatility_regime_raw

// ============================================================
// ML-001-R2 CANONICAL FEATURE BLOCK -- END
// ============================================================

// --- warmup status booleans (live chart) ---
momentum5Warmup        = bar_index < 5
momentum20Warmup       = bar_index < 20
rsi14Warmup            = bar_index < 100
atr14Warmup            = bar_index < 100
volatilityRegimeWarmup = bar_index < 600
allWarmedUp            = not (momentum5Warmup or momentum20Warmup or rsi14Warmup or atr14Warmup or volatilityRegimeWarmup)

// ============================================================
// FIXTURE REPLAY VERIFICATION BLOCK (debug-script-only)
// ------------------------------------------------------------
// NOT part of the "CANONICAL FEATURE BLOCK" above and NOT duplicated
// into ml_001_r2_features.pine or ML_001_R2_STRATEGY.pine. This block
// re-derives momentum/delta/gain/loss/True-Range from the EMBEDDED
// fixture OHLC (bars 0-159 of ML-001-R2-PINE-PARITY-FIXTURE.csv, since
// Pine has no way to override the built-in close/high/low series with
// arbitrary historical data, and TradingView's own real EURUSD/GBPUSD
// price history will never numerically match a synthetic fixture) and
// feeds it through the SAME f_seededWilder() function defined above
// (genuine code reuse, not a re-implementation) so the trickiest piece
// of logic -- the seeded-Wilder recurrence -- is never duplicated.
// Only the stateless one-line formulas (momentum, delta/gain/loss, TR,
// RSI combination) are re-expressed here against fixture inputs; each
// one is a direct line-for-line copy of its counterpart above and
// should be diffed against the canonical block by eye on every edit.
//
// Numerical tolerances are declared HERE, before any comparison runs,
// per Phase 7's requirement that tolerance be fixed in advance of
// seeing discrepancies:
TOL_MOMENTUM = 0.0000001   // 1e-7 absolute, momentum is a small ratio
TOL_RSI      = 0.0001      // 1e-4 absolute, RSI is on a 0-100 scale
TOL_ATR      = 0.0000001   // 1e-7 absolute, ATR is a small price-scale value
// ============================================================

var array<float> fxOpen  = array.from(1.100000, 1.101309, 1.100937, 1.101403, 1.101249, 1.101011, 1.101410, 1.101487, 1.100817, 1.100742, 1.100843, 1.100863, 1.101226, 1.101091, 1.101439, 1.101759, 1.101230, 1.101038, 1.100719, 1.101923, 1.101226, 1.101236, 1.101671, 1.101369, 1.101455, 1.101812, 1.101313, 1.100757, 1.101287, 1.101094, 1.100960, 1.101256, 1.101507, 1.101214, 1.101686, 1.101324, 1.101629, 1.101558, 1.101225, 1.100765, 1.101453, 1.101338, 1.101796, 1.102268, 1.102483, 1.102360, 1.102174, 1.101706, 1.101779, 1.101777, 1.101637, 1.101878, 1.102339, 1.101942, 1.102026, 1.102291, 1.102264, 1.102168, 1.101799, 1.101770, 1.102076, 1.101878, 1.101909, 1.101314, 1.101133, 1.101950, 1.102162, 1.102871, 1.102923, 1.102431, 1.102618, 1.102530, 1.102567, 1.103027, 1.103247, 1.103563, 1.102808, 1.102278, 1.101766, 1.101780, 1.101396, 1.101339, 1.100704, 1.100859, 1.100304, 1.100724, 1.101771, 1.101293, 1.101604, 1.101985, 1.101346, 1.101317, 1.101219, 1.101882, 1.102210, 1.102381, 1.102504, 1.102068, 1.102284, 1.102040, 1.101971, 1.102383, 1.102112, 1.102487, 1.103204, 1.103204, 1.102987, 1.103287, 1.103726, 1.103706, 1.104569, 1.104644, 1.104777, 1.105047, 1.105121, 1.105349, 1.106240, 1.105848, 1.105963, 1.105522, 1.104851, 1.104851, 1.104851, 1.104851, 1.104851, 1.104851, 1.104851, 1.104851, 1.104851, 1.104851, 1.104851, 1.104851, 1.104851, 1.104851, 1.104851, 1.104851, 1.104851, 1.104851, 1.104851, 1.104851, 1.104851, 1.104851, 1.104851, 1.104851, 1.104851, 1.104851, 1.104851, 1.104851, 1.104851, 1.104851, 1.104851, 1.105101, 1.105351, 1.105601, 1.105851, 1.106101, 1.106351, 1.106601, 1.106851, 1.107101)

