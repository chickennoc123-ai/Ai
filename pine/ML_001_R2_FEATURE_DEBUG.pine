var array<float> fxExpRsi14      = array.from(na, na, na, na, na, na, na, na, na, na, na, na, na, na, na, na, na, na, na, na, na, na, na, na, na, na, na, na, na, na, na, na, na, na, na, na, na, na, na, na, na, na, na, na, na, na, na, na, na, na, na, na, na, na, na, na, na, na, na, na, na, na, na, na, na, na, na, na, na, na, na, na, na, na, na, na, na, na, na, na, na, na, na, na, na, na, na, na, na, na, na, na, na, na, na, na, na, na, na, na, 55.53336951, 52.17774650, 56.13750621, 62.52205634, 62.52506709, 59.48125336, 62.21671977, 65.84917262, 65.54155039, 71.71501883, 72.17808065, 73.03012981, 74.71430772, 75.17556820, 76.58137573, 81.09735591, 74.31156797, 74.97100426, 67.77316242, 58.53589704, 58.53589704, 58.53589704, 58.53589704, 58.53589704, 58.53589704, 58.53589704, 58.53589704, 58.53589704, 58.53589704, 58.53589704, 58.53589704, 58.53589704, 58.53589704, 58.53589704, 58.53589704, 58.53589704, 58.53589704, 58.53589704, 58.53589704, 58.53589704, 58.53589704, 58.53589704, 58.53589704, 58.53589704, 58.53589704, 58.53589704, 58.53589704, 58.53589704, 58.53589704, 58.53589704, 72.44074150, 79.75284775, 84.25243806, 87.29346826, 89.48105081, 91.12628454, 92.40548845, 93.42606253, 94.25716689, 94.94535245)

var array<float> fxExpAtr14      = array.from(na, na, na, na, na, na, na, na, na, na, na, na, na, na, na, na, na, na, na, na, na, na, na, na, na, na, na, na, na, na, na, na, na, na, na, na, na, na, na, na, na, na, na, na, na, na, na, na, na, na, na, na, na, na, na, na, na, na, na, na, na, na, na, na, na, na, na, na, na, na, na, na, na, na, na, na, na, na, na, na, na, na, na, na, na, na, na, na, na, na, na, na, na, na, na, na, na, na, na, na, 0.0009105559, 0.0008986939, 0.0008998657, 0.0009301456, 0.0008880707, 0.0008624227, 0.0008725948, 0.0008450755, 0.0008089211, 0.0008315987, 0.0008067993, 0.0007961698, 0.0007882484, 0.0007890482, 0.0007772116, 0.0008266569, 0.0008373437, 0.0008129718, 0.0008331262, 0.0008425981, 0.0007825553, 0.0007268014, 0.0006750299, 0.0006269563, 0.0005823166, 0.0005408654, 0.0005023750, 0.0004666339, 0.0004334458, 0.0004026282, 0.0003740119, 0.0003474396, 0.0003227654, 0.0002998536, 0.0002785783, 0.0002588227, 0.0002404782, 0.0002234441, 0.0002076266, 0.0001929390, 0.0001793005, 0.0001666362, 0.0001548765, 0.0001439567, 0.0001338170, 0.0001244015, 0.0001156585, 0.0001075400, 0.0001000015, 0.0000930014, 0.0001203657, 0.0001480972, 0.0001731031, 0.0001901604, 0.0002103277, 0.0002345511, 0.0002646894, 0.0002775107, 0.0002988268, 0.0003212387)

fxN             = array.size(fxClose)
inFixtureRange  = bar_index < fxN

fxC = inFixtureRange ? array.get(fxClose, bar_index) : na
fxH = inFixtureRange ? array.get(fxHigh,  bar_index) : na
fxL = inFixtureRange ? array.get(fxLow,   bar_index) : na

// --- momentum (line-for-line copy of the canonical formula, fixture inputs) ---
pine_mom5_raw  = bar_index >= 5  and inFixtureRange ? (fxC - array.get(fxClose, bar_index - 5))  / array.get(fxClose, bar_index - 5)  : na
pine_mom20_raw = bar_index >= 20 and inFixtureRange ? (fxC - array.get(fxClose, bar_index - 20)) / array.get(fxClose, bar_index - 20) : na
pine_mom5  = inFixtureRange ? (bar_index < 5  ? na : pine_mom5_raw)  : na
pine_mom20 = inFixtureRange ? (bar_index < 20 ? na : pine_mom20_raw) : na

// --- delta / gain / loss / True Range (line-for-line copy, fixture inputs) ---
fxPrevClose = bar_index >= 1 and inFixtureRange ? array.get(fxClose, bar_index - 1) : na
fxDelta     = inFixtureRange ? (bar_index >= 1 ? fxC - fxPrevClose : na) : na
fxGain      = inFixtureRange ? (na(fxDelta) ? na : (fxDelta >= 0 ? fxDelta : 0.0)) : na
fxLoss      = inFixtureRange ? (na(fxDelta) ? na : (fxDelta <  0 ? -fxDelta : 0.0)) : na
fxTR        = inFixtureRange ? (bar_index == 0 ? (fxH - fxL) :
                 math.max(fxH - fxL, math.max(math.abs(fxH - fxPrevClose), math.abs(fxL - fxPrevClose)))) : na

// --- RSI / ATR: reuse the CANONICAL f_seededWilder function directly ---
// (genuine code reuse -- this is the same function defined in the
// canonical block above, called with different, independent arguments;
// Pine's per-call-site `var` state means this creates its own separate
// accumulator, not shared with the live-chart avg_gain/avg_loss above)
fx_avg_gain = f_seededWilder(fxGain, 14, 1)
fx_avg_loss = f_seededWilder(fxLoss, 14, 1)

fx_rsi_raw = na(fx_avg_gain) or na(fx_avg_loss) ? na :
             (fx_avg_loss == 0.0 and fx_avg_gain == 0.0) ? 50.0 :
             (fx_avg_loss == 0.0) ? 100.0 :
             100.0 - 100.0 / (1.0 + fx_avg_gain / fx_avg_loss)

fx_atr_raw_unmasked = f_seededWilder(fxTR, 14, 0)

pine_rsi14 = inFixtureRange ? (bar_index < 100 ? na : fx_rsi_raw) : na
pine_atr14 = inFixtureRange ? (bar_index < 100 ? na : fx_atr_raw_unmasked) : na

// --- expected values (Python's own recorded output for these bars) ---
expMom5  = inFixtureRange ? array.get(fxExpMomentum5,  bar_index) : na
expMom20 = inFixtureRange ? array.get(fxExpMomentum20, bar_index) : na
expRsi14 = inFixtureRange ? array.get(fxExpRsi14,      bar_index) : na
expAtr14 = inFixtureRange ? array.get(fxExpAtr14,      bar_index) : na

diffMom5  = (na(pine_mom5)  or na(expMom5))  ? na : pine_mom5  - expMom5
diffMom20 = (na(pine_mom20) or na(expMom20)) ? na : pine_mom20 - expMom20
diffRsi14 = (na(pine_rsi14) or na(expRsi14)) ? na : pine_rsi14 - expRsi14
diffAtr14 = (na(pine_atr14) or na(expAtr14)) ? na : pine_atr14 - expAtr14

// volatility_regime is NOT embedded here: its warmup is 600 bars, far
// beyond this 160-bar embed (Pine script size limits made a 600+/770-bar
// embed impractical). Beyond-bar-160 / volatility_regime spot checks are
// covered instead by documented expected values in
// ML-001-R2-TRADINGVIEW-MANUAL-TEST-GUIDE.md, referencing the full CSV.

// --- running max-abs-diff / tolerance-exceeded counters across bars 0-159 ---
var float maxAbsDiffMom5   = na
var float maxAbsDiffMom20  = na
var float maxAbsDiffRsi14  = na
var float maxAbsDiffAtr14  = na
var int   mismatchCountMom5  = 0
var int   mismatchCountMom20 = 0
var int   mismatchCountRsi14 = 0
var int   mismatchCountAtr14 = 0

if not na(diffMom5)
    maxAbsDiffMom5 := na(maxAbsDiffMom5) ? math.abs(diffMom5) : math.max(maxAbsDiffMom5, math.abs(diffMom5))
    if math.abs(diffMom5) > TOL_MOMENTUM
        mismatchCountMom5 += 1
if not na(diffMom20)
    maxAbsDiffMom20 := na(maxAbsDiffMom20) ? math.abs(diffMom20) : math.max(maxAbsDiffMom20, math.abs(diffMom20))
    if math.abs(diffMom20) > TOL_MOMENTUM
        mismatchCountMom20 += 1
if not na(diffRsi14)
    maxAbsDiffRsi14 := na(maxAbsDiffRsi14) ? math.abs(diffRsi14) : math.max(maxAbsDiffRsi14, math.abs(diffRsi14))
    if math.abs(diffRsi14) > TOL_RSI
        mismatchCountRsi14 += 1
if not na(diffAtr14)
    maxAbsDiffAtr14 := na(maxAbsDiffAtr14) ? math.abs(diffAtr14) : math.max(maxAbsDiffAtr14, math.abs(diffAtr14))
    if math.abs(diffAtr14) > TOL_ATR
        mismatchCountAtr14 += 1

// ============================================================
// DISPLAY: plots (Data Window, so the user can hover any bar and read
// exact values -- the precise "inspect values manually" mechanism)
// ============================================================
plot(momentum_5,        title = "momentum_5",        color = color.blue)
plot(momentum_20,       title = "momentum_20",       color = color.purple)
plot(rsi_14,             title = "rsi_14",            color = color.orange)
plot(atr_14,             title = "atr_14",            color = color.red)
plot(volatility_regime,  title = "volatility_regime", color = color.green, style = plot.style_stepline)

plot(bar_index, title = "bar_index",  display = display.data_window)
plot(time,      title = "bar_time",   display = display.data_window)

plot(momentum5Warmup        ? 1.0 : 0.0, title = "momentum_5 warmup",        display = display.data_window)
plot(momentum20Warmup       ? 1.0 : 0.0, title = "momentum_20 warmup",       display = display.data_window)
plot(rsi14Warmup            ? 1.0 : 0.0, title = "rsi_14 warmup",            display = display.data_window)
plot(atr14Warmup            ? 1.0 : 0.0, title = "atr_14 warmup",            display = display.data_window)
plot(volatilityRegimeWarmup ? 1.0 : 0.0, title = "volatility_regime warmup", display = display.data_window)
plot(allWarmedUp            ? 1.0 : 0.0, title = "ALL_WARMED_UP",            display = display.data_window)

plot(fixtureReplayMode ? pine_mom5  : na, title = "[fixture] pine momentum_5",  display = display.data_window)
plot(fixtureReplayMode ? expMom5    : na, title = "[fixture] expected momentum_5 (Python)", display = display.data_window)
plot(fixtureReplayMode ? diffMom5   : na, title = "[fixture] diff momentum_5",  display = display.data_window)
plot(fixtureReplayMode ? pine_mom20 : na, title = "[fixture] pine momentum_20", display = display.data_window)
plot(fixtureReplayMode ? expMom20   : na, title = "[fixture] expected momentum_20 (Python)", display = display.data_window)
plot(fixtureReplayMode ? diffMom20  : na, title = "[fixture] diff momentum_20", display = display.data_window)
plot(fixtureReplayMode ? pine_rsi14 : na, title = "[fixture] pine rsi_14",      display = display.data_window)
plot(fixtureReplayMode ? expRsi14   : na, title = "[fixture] expected rsi_14 (Python)", display = display.data_window)
plot(fixtureReplayMode ? diffRsi14  : na, title = "[fixture] diff rsi_14",      display = display.data_window)
plot(fixtureReplayMode ? pine_atr14 : na, title = "[fixture] pine atr_14",      display = display.data_window)
plot(fixtureReplayMode ? expAtr14   : na, title = "[fixture] expected atr_14 (Python)", display = display.data_window)
plot(fixtureReplayMode ? diffAtr14  : na, title = "[fixture] diff atr_14",      display = display.data_window)

// ============================================================
// DISPLAY: summary table (top-right, redrawn on the last bar only)
// ============================================================
if debugMode and barstate.islast
    var table dbgTable = table.new(position.top_right, 5, 8, bgcolor = color.new(color.black, 20), border_width = 1, border_color = color.gray)
    table.cell(dbgTable, 0, 0, "ML-001-R2 FEATURE DEBUG",           text_color = color.white, bgcolor = color.new(color.blue, 40))
    table.cell(dbgTable, 1, 0, "MANUAL TEST ONLY",                  text_color = color.white, bgcolor = color.new(color.blue, 40))
    table.cell(dbgTable, 2, 0, "NOT FOR TRADING",                   text_color = color.white, bgcolor = color.new(color.blue, 40))
    table.cell(dbgTable, 3, 0, "ECON=UNPROVEN",                     text_color = color.white, bgcolor = color.new(color.blue, 40))
    table.cell(dbgTable, 4, 0, "PROD=BLOCKED",                      text_color = color.white, bgcolor = color.new(color.blue, 40))

    table.cell(dbgTable, 0, 1, "feature")
    table.cell(dbgTable, 1, 1, "live value")
    table.cell(dbgTable, 2, 1, "warmup?")
    table.cell(dbgTable, 3, 1, "fixture max|diff| (0-159)")
    table.cell(dbgTable, 4, 1, "fixture mismatches>tol")

    table.cell(dbgTable, 0, 2, "momentum_5")
    table.cell(dbgTable, 1, 2, str.tostring(momentum_5))
    table.cell(dbgTable, 2, 2, momentum5Warmup ? "WARMUP" : "OK")
    table.cell(dbgTable, 3, 2, na(maxAbsDiffMom5) ? "n/a" : str.tostring(maxAbsDiffMom5))
    table.cell(dbgTable, 4, 2, str.tostring(mismatchCountMom5))

    table.cell(dbgTable, 0, 3, "momentum_20")
    table.cell(dbgTable, 1, 3, str.tostring(momentum_20))
    table.cell(dbgTable, 2, 3, momentum20Warmup ? "WARMUP" : "OK")
    table.cell(dbgTable, 3, 3, na(maxAbsDiffMom20) ? "n/a" : str.tostring(maxAbsDiffMom20))
    table.cell(dbgTable, 4, 3, str.tostring(mismatchCountMom20))

    table.cell(dbgTable, 0, 4, "rsi_14")
    table.cell(dbgTable, 1, 4, str.tostring(rsi_14))
    table.cell(dbgTable, 2, 4, rsi14Warmup ? "WARMUP" : "OK")
    table.cell(dbgTable, 3, 4, na(maxAbsDiffRsi14) ? "n/a" : str.tostring(maxAbsDiffRsi14))
    table.cell(dbgTable, 4, 4, str.tostring(mismatchCountRsi14))

    table.cell(dbgTable, 0, 5, "atr_14")
    table.cell(dbgTable, 1, 5, str.tostring(atr_14))
    table.cell(dbgTable, 2, 5, atr14Warmup ? "WARMUP" : "OK")
    table.cell(dbgTable, 3, 5, na(maxAbsDiffAtr14) ? "n/a" : str.tostring(maxAbsDiffAtr14))
    table.cell(dbgTable, 4, 5, str.tostring(mismatchCountAtr14))

    table.cell(dbgTable, 0, 6, "volatility_regime")
    table.cell(dbgTable, 1, 6, str.tostring(volatility_regime))
    table.cell(dbgTable, 2, 6, volatilityRegimeWarmup ? "WARMUP" : "OK")
    table.cell(dbgTable, 3, 6, "n/a (not embedded; see CSV)")
    table.cell(dbgTable, 4, 6, "n/a")

    table.cell(dbgTable, 0, 7, "tolerances: mom=" + str.tostring(TOL_MOMENTUM) + " rsi=" + str.tostring(TOL_RSI) + " atr=" + str.tostring(TOL_ATR))
    table.cell(dbgTable, 1, 7, "fixtureReplayMode=" + str.tostring(fixtureReplayMode))
    table.cell(dbgTable, 2, 7, "bar_index=" + str.tostring(bar_index))
    table.cell(dbgTable, 3, 7, "ALL_WARMED_UP=" + str.tostring(allWarmedUp))
    table.cell(dbgTable, 4, 7, "")
