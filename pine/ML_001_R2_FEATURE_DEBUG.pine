var array<float> fxExpMomentum20 = array.from(na, na, na, na, na, na, na, na, na, na, na, na, na, na, na, na, na, na, na, na, -0.0000659789, 0.0006672844, -0.0000305232, 0.0001871993, 0.0007275114, -0.0000888310, -0.0006628696, 0.0004273279, 0.0003203238, 0.0001060064, 0.0003572573, 0.0002550530, 0.0001120613, 0.0002241613, -0.0003952500, 0.0003630527, 0.0004723446, 0.0004596424, -0.0010509966, 0.0002062228, 0.0000925093, 0.0001129721, 0.0008164292, 0.0009327960, 0.0004979481, 0.0007818667, 0.0008616764, 0.0004460936, 0.0006196991, 0.0006147542, 0.0005646100, 0.0007550535, 0.0006602992, 0.0003086424, 0.0008776366, 0.0005758394, 0.0005529215, 0.0005211152, 0.0009132535, 0.0005658344, 0.0004903711, 0.0001029938, -0.0008661111, -0.0012241142, -0.0003726234, -0.0000109001, 0.0010579474, 0.0010383299, 0.0005936013, 0.0008910906, 0.0005918652, 0.0002066706, 0.0009853065, 0.0011077167, 0.0011547948, 0.0004938318, 0.0001000894, -0.0000304415, 0.0000089819, -0.0006165824, -0.0004887836, -0.0010935252, -0.0004131845, -0.0007529243, -0.0011122499, -0.0003541821, -0.0014311875, -0.0011959989, -0.0004044333, -0.0011543169, -0.0010999559, -0.0012220995, -0.0010382770, -0.0009395136, -0.0010715166, -0.0002754216, -0.0001902866, 0.0004709719, 0.0002362503, 0.0005217416, 0.0009471966, 0.0012792033, 0.0014794297, 0.0026355337, 0.0022533586, 0.0011035192, 0.0018107527, 0.0019266042, 0.0015619900, 0.0029269305, 0.0030205826, 0.0032309244, 0.0028719332, 0.0026407166, 0.0026920195, 0.0033880930, 0.0034297865, 0.0033367368, 0.0031596878, 0.0026129968, 0.0022386389, 0.0024845143, 0.0021434428, 0.0014924944, 0.0014921610, 0.0016894106, 0.0014170359, 0.0010188237, 0.0010368691, 0.0002546018, 0.0001871769, 0.0000663798, -0.0001774849, -0.0002448425, -0.0004506099, -0.0012558687, -0.0009019465, -0.0010054530, -0.0006076937, 0.0000000000, 0.0000000000, 0.0000000000, 0.0000000000, 0.0000000000, 0.0000000000, 0.0000000000, 0.0000000000, 0.0000000000, 0.0000000000, 0.0000000000, 0.0002262750, 0.00